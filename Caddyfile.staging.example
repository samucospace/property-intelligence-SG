# Protected pre-launch site. Set STAGING_DOMAIN, STAGING_BASIC_AUTH_USER and
# STAGING_BASIC_AUTH_HASH in Caddy's private runtime environment. Generate the
# password hash with Caddy; keep the plaintext password in the owner's vault.
{$STAGING_DOMAIN} {
    encode gzip zstd
    header X-Robots-Tag "noindex, nofollow, noarchive"
    basic_auth {
        {$STAGING_BASIC_AUTH_USER} {$STAGING_BASIC_AUTH_HASH}
    }
    reverse_proxy app:3001 {
        header_up -X-Admin-Gateway
        header_up -Authorization
    }
}
