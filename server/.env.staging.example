# Copy to .env.staging and load explicitly with node --env-file.
# Staging never reads server/.env and accepts only prepared, marked databases.
NODE_ENV=staging
PORT=3002
DB_PATH=server/staging-phase0-20261002.db
RELEASE_SCOPE=analytics-readonly
MOCK_EMAIL=true
RESEND_API_KEY=re_mock_staging
URA_ACCESS_KEY=mock_staging
ENABLE_DATA_SYNC=false
ENABLE_LEAD_CLEANUP=false
ENABLE_STARTUP_LEAD_CLEANUP=false
ENABLE_OUTBOUND_EMAIL=false
ENABLE_SCHEDULED_NEWSLETTER=false
BASE_URL=http://127.0.0.1:3002
# For isolated full-product fixture testing only, set RELEASE_SCOPE=full
# and supply separate test ADMIN_API_KEY and UNSUBSCRIBE_SECRET values.
