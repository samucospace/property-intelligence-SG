# Server Configuration
PORT=3001
NODE_ENV=production
RELEASE_SCOPE=analytics-readonly
ENABLE_DATA_SYNC=false
ENABLE_LEAD_CLEANUP=false
ENABLE_STARTUP_LEAD_CLEANUP=false
ENABLE_OUTBOUND_EMAIL=false
ENABLE_SCHEDULED_NEWSLETTER=false

# Security & Ingestion Access
# Protects /api/ingest/* endpoints from unauthorized public requests (min 32 random characters)
ADMIN_API_KEY=

# Dedicated secret for HMAC-SHA256 unsubscribe links (min 16 random characters, never share with ADMIN_API_KEY)
UNSUBSCRIBE_SECRET=
# Optional cut-off date for accepting legacy SHA-256 unsubscribe links (ISO YYYY-MM-DD)
LEGACY_UNSUB_UNTIL=2026-12-31

# URA Data Service Credentials (Used only on server by batch cron jobs)
URA_ACCESS_KEY=
# Start quarter for rental ingestion (format: yyqq, defaults to 21q1)
URA_RENTAL_START=21q1

# Automated Weekly Newsletter (Resend API)
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=Singapore Home Intel <digest@homeintel.sg>
BASE_URL=https://homeintel.sg

# Allowed Origins (Optional, defaults to same-origin only in production)
# ALLOWED_ORIGIN=https://homeintel.sg

# Production backups require a separately stored key file or encryption secret.
# BACKUP_KEY_FILE=/run/secrets/property-backup-key
# BACKUP_ENCRYPTION_KEY=
