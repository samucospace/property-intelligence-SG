# Caddyfile for automated HTTPS & Gzip/Zstandard reverse proxy
# Set DOMAIN in environment (e.g. DOMAIN=homeintel.sg) or defaults to localhost

{$DOMAIN:localhost} {
    encode gzip zstd
    reverse_proxy app:3001 {
        # Only a separately protected administrative gateway may supply this.
        header_up -X-Admin-Gateway
    }
}

