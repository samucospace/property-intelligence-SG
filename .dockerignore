# Dependencies & local builds
**/node_modules/
client/dist/
dist/

# SQLite databases & backups (never bake live databases into images)
server/property.db*
server/backups/
/.recovery-keys/
*.db.enc
audit/
backups/
data/
!server/data/
!server/data/**
!server/migrations/data/
!server/migrations/data/**
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Version control & secrets
.git/
.gitignore
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.staging.example
!**/.env.example
!**/.env.staging.example
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite3
**/*.sqlite-wal
**/*.sqlite-shm
**/backups/

# Logs & OS artifacts
*.log
logs/
Thumbs.db
.DS_Store

# Scratch & test scripts
screenshot*.png
server/scratch_*
server/test_*
server/tests/temp-*/
*.maintenance
*.swap.json
*.generation
*.db.backup-*
*.db.rebuild-*
server/scripts/newsletter-preview.html

# Internal review & planning docs
TECHNICAL_REVIEW.md
REMEDIATION_PLAN.md
# Never bake privacy ledgers or local test outputs into release artifacts
*.privacy.jsonl
privacy/
privacy-replica/
server/tests/*results.json
